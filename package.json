{
  "name": "studyplanner-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.mjs --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "typecheck:build": "tsc --noEmit -p tsconfig.build.json",
    "build": "vite build --config vite.config.mjs",
    "verify": "npm run typecheck && npm run test:run && npm run build",
    "preview:vite": "vite preview --config vite.config.mjs --host 0.0.0.0",
    "preview": "node ./scripts/preview-server.mjs",
    "cert:dev": "node ./scripts/generate-dev-cert.mjs",
    "deploy:firestore-rules": "npx firebase-tools deploy --only firestore:rules",
    "deploy:worker": "npx wrangler deploy --config workers/ai-proxy/wrangler.jsonc",
    "test": "node ./node_modules/vitest/vitest.mjs --config vite.config.mjs",
    "test:run": "node ./node_modules/vitest/vitest.mjs --config vite.config.mjs run",
    "test:nl": "node ./node_modules/vitest/vitest.mjs --config vite.config.mjs src/services/natural-language",
    "test:nl:run": "node ./node_modules/vitest/vitest.mjs --config vite.config.mjs run src/services/natural-language",
    "test:weekly-ai:conversation:foundation": "node ./node_modules/vitest/vitest.mjs --config vite.config.mjs run src/features/weeklyPlanning/evals/weeklyPlanningConversationEvalDriver.test.ts src/features/weeklyPlanning/evals/weeklyPlanningConversationEvalContracts.test.ts src/features/weeklyPlanning/evals/weeklyPlanningConversationEvalScenarioManifest.test.ts --reporter=verbose",
    "test:weekly-ai:conversation:real": "node ./node_modules/vitest/vitest.mjs --config vite.config.mjs run src/features/weeklyPlanning/evals/weeklyPlanningStableV5Conversation.real-eval.test.ts --reporter=verbose",
    "test:mutation:weekly-planning": "npx --yes --package=@stryker-mutator/core@9.6.1 --package=@stryker-mutator/vitest-runner@9.6.1 --package=@stryker-mutator/typescript-checker@9.6.1 stryker run stryker.config.mjs"
  },
  "dependencies": {
    "firebase": "^12.12.0",
    "lucide-react": "^1.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-test-renderer": "^18.3.1",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "fast-check": "^4.8.0",
    "react-test-renderer": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.4"
  }
}
