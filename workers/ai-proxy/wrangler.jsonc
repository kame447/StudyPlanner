    "JEV_FOCUSED_CONTEXTUAL_ANSWER_CANARY_PERCENT": "100",
    "JEV_TEMPORAL_SCOPE_REPAIR_MODE": "canary",
    "JEV_TEMPORAL_SCOPE_REPAIR_CANARY_PERCENT": "100",
    "JEV_USER_CONTEXT_ROUTING_MODE": "off",
    "JEV_USER_CONTEXT_ROUTING_CANARY_PERCENT": "0",
    "JEV_CANDIDATE_CHOICE_MODE": "off",
    "JEV_CANDIDATE_CHOICE_CANARY_PERCENT": "0",
    "FIREBASE_WEB_API_KEY": "AIzaSyAMS_X5k0BFL2dtoLOGjPV22lcUj5gI7oo",
    "ALLOWED_ORIGIN": "https://laplance.com,https://studyplannner.pages.dev,https://studyplanner.pages.dev,https://agent-trace-production-recov.studyplannner.pages.dev,https://agent-trace-log-schema-simpl.studyplannner.pages.dev,http://localhost:5173,https://localhost:5173,https://localhost:4173,http://127.0.0.1:5173,https://127.0.0.1:5173,https://127.0.0.1:4173,https://192.168.0.5:5173,https://192.168.0.5:4173",
    "ALLOWED_CHAT_MODELS": "gpt-6-luna,gpt-5.6-luna",
