rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /profiles/{userId} {
      allow read, create, update: if isOwner(userId);
      allow delete: if false;
    }

    match /plans/{planId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId)
        && isOwner(request.resource.data.userId);
    }

    match /actuals/{actualId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId)
        && isOwner(request.resource.data.userId);
    }

    match /day_notes/{dayNoteId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId)
        && isOwner(request.resource.data.userId);
    }

    match /month_events/{monthEventId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId)
        && isOwner(request.resource.data.userId);
    }

    match /todos/{todoId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId)
        && isOwner(request.resource.data.userId);
    }

    match /study_subjects/{subjectId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId)
        && isOwner(request.resource.data.userId);
    }

    match /study_materials/{materialId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId)
        && isOwner(request.resource.data.userId);
    }

    match /schedule_templates/{scheduleTemplateId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId)
        && isOwner(request.resource.data.userId);
    }

    match /timetable_terms/{termId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId)
        && isOwner(request.resource.data.userId);
    }

    match /timetable_periods/{periodId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId)
        && isOwner(request.resource.data.userId);
    }

    match /app_catalogs/{catalogId} {
      allow read: if true;
      allow create, update: if false;
      allow delete: if false;
    }
  }
}
