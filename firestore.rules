rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function canReadOwnedResource() {
      return isOwner(resource.data.userId) || isAdmin();
    }

    function canCreateOwnedResource() {
      return isOwner(request.resource.data.userId);
    }

    function canUpdateOwnedResource() {
      return isOwner(resource.data.userId)
        && isOwner(request.resource.data.userId);
    }

    match /admins/{adminId} {
      allow get: if isOwner(adminId) || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /profiles/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && !request.resource.data.keys().hasAny(['weeklyPlanningTracePolicy']);
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'id',
          'email',
          'username',
          'avatar',
          'createdAt'
        ]);
      allow delete: if false;
    }

    match /plans/{planId} {
      allow read: if canReadOwnedResource();
      allow create: if canCreateOwnedResource();
      allow update: if canUpdateOwnedResource();
      allow delete: if isOwner(resource.data.userId);
    }

    match /actuals/{actualId} {
      allow read: if canReadOwnedResource();
      allow create: if canCreateOwnedResource();
      allow update: if canUpdateOwnedResource();
      allow delete: if isOwner(resource.data.userId);
    }

    match /day_notes/{dayNoteId} {
      allow read: if canReadOwnedResource();
      allow create: if canCreateOwnedResource();
      allow update: if canUpdateOwnedResource();
      allow delete: if isOwner(resource.data.userId);
    }

    match /month_events/{monthEventId} {
      allow read: if canReadOwnedResource();
      allow create: if canCreateOwnedResource();
      allow update: if canUpdateOwnedResource();
      allow delete: if isOwner(resource.data.userId);
    }

    match /todos/{todoId} {
      allow read: if canReadOwnedResource();
      allow create: if canCreateOwnedResource();
      allow update: if canUpdateOwnedResource();
      allow delete: if isOwner(resource.data.userId);
    }

    match /study_subjects/{subjectId} {
      allow read: if canReadOwnedResource();
      allow create: if canCreateOwnedResource();
      allow update: if canUpdateOwnedResource();
      allow delete: if isOwner(resource.data.userId);
    }

    match /study_materials/{materialId} {
      allow read: if canReadOwnedResource();
      allow create: if canCreateOwnedResource();
      allow update: if canUpdateOwnedResource();
      allow delete: if isOwner(resource.data.userId);
    }

    match /schedule_templates/{scheduleTemplateId} {
      allow read: if canReadOwnedResource();
      allow create: if canCreateOwnedResource();
      allow update: if canUpdateOwnedResource();
      allow delete: if isOwner(resource.data.userId);
    }

    match /timetable_terms/{termId} {
      allow read: if canReadOwnedResource();
      allow create: if canCreateOwnedResource();
      allow update: if canUpdateOwnedResource();
      allow delete: if isOwner(resource.data.userId);
    }

    match /timetable_periods/{periodId} {
      allow read: if canReadOwnedResource();
      allow create: if canCreateOwnedResource();
      allow update: if canUpdateOwnedResource();
      allow delete: if isOwner(resource.data.userId);
    }

    match /weekly_planning_approval_operations/{operationId} {
      allow read: if canReadOwnedResource();
      allow create: if canCreateOwnedResource()
        && request.resource.data.schemaVersion == 1
        && request.resource.data.savedItemCount >= 1
        && (
          request.resource.data.status == 'active'
          || (
            request.resource.data.status == 'completed'
            && request.resource.data.expectedItemCount == request.resource.data.savedItemCount
            && request.resource.data.completedAt is string
          )
        );
      allow update: if canUpdateOwnedResource()
        && request.resource.data.schemaVersion == resource.data.schemaVersion
        && request.resource.data.approvalOperationId == resource.data.approvalOperationId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.savedItemCount >= resource.data.savedItemCount
        && (resource.data.status != 'completed' || request.resource.data.status == 'completed')
        && (
          request.resource.data.status != 'completed'
          || (
            request.resource.data.expectedItemCount == request.resource.data.savedItemCount
            && request.resource.data.completedAt is string
          )
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'savedItemCount',
          'expectedItemCount',
          'updatedAt',
          'completedAt',
          'expiresAt'
        ]);
      allow delete: if false;

      match /weekly_planning_approval_items/{itemId} {
        allow read: if canReadOwnedResource();
        allow create: if canCreateOwnedResource()
          && request.resource.data.schemaVersion == 1
          && request.resource.data.status == 'saved'
          && request.resource.data.approvalOperationId is string
          && request.resource.data.sourceDraftBlockId is string
          && request.resource.data.savedPlanId is string
          && request.resource.data.expiresAt is timestamp;
        allow update: if canUpdateOwnedResource()
          && request.resource.data.schemaVersion == resource.data.schemaVersion
          && request.resource.data.approvalOperationId == resource.data.approvalOperationId
          && request.resource.data.sourceDraftBlockId == resource.data.sourceDraftBlockId
          && request.resource.data.savedPlanId == resource.data.savedPlanId
          && request.resource.data.status == resource.data.status
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.expiresAt >= resource.data.expiresAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'updatedAt',
            'expiresAt'
          ]);
        allow delete: if false;
      }
    }

    match /weekly_planning_trace_sessions/{sessionId} {
      allow read, write: if false;
    }

    match /weekly_planning_trace_entries/{entryId} {
      allow read, write: if false;
    }

    match /weekly_planning_trace_access_audit/{auditId} {
      allow read, write: if false;
    }

    match /app_catalogs/{catalogId} {
      allow read: if true;
      allow create, update: if false;
      allow delete: if false;
    }
  }
}
