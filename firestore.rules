rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasAcceptedWeeklyPlanningPolicy() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid))
          .data.weeklyPlanningTracePolicy.version == '2026-07-18-v1';
    }

    function canReadOwnedResource() {
      return isOwner(resource.data.userId) || isAdmin();
    }

    function canCreateOwnedResource() {
      return isOwner(request.resource.data.userId);
    }

    function canUpdateOwnedResource() {
      return isOwner(resource.data.userId)
        && isOwner(request.resource.data.userId);
    }

    function hasScheduleEventMigration(userId) {
      return exists(
        /databases/$(database)/documents/schedule_event_migrations/$(userId)
      );
    }

    function canCreateLegacyScheduleResource() {
      return canCreateOwnedResource()
        && !hasScheduleEventMigration(request.resource.data.userId);
    }

    function canUpdateLegacyScheduleResource() {
      return canUpdateOwnedResource()
        && !hasScheduleEventMigration(resource.data.userId);
    }

    function canDeleteLegacyScheduleResource() {
      return isOwner(resource.data.userId)
        && !hasScheduleEventMigration(resource.data.userId);
    }

    function isNullableString(value) {
      return value == null || value is string;
    }

    function hasValidScheduleEventRecurrence() {
      return request.resource.data.recurrence is map
        && request.resource.data.recurrence.keys().hasAll([
          'repeat',
          'repeatUntil',
          'excludedDates',
          'rules'
        ])
        && request.resource.data.recurrence.repeat is string
        && isNullableString(request.resource.data.recurrence.repeatUntil)
        && request.resource.data.recurrence.excludedDates is list
        && request.resource.data.recurrence.rules is list;
    }

    function hasValidScheduleEventProvenance() {
      return request.resource.data.provenance is map
        && request.resource.data.provenance.keys().hasAll([
          'legacy',
          'sourceType',
          'sourceId'
        ])
        && request.resource.data.provenance.legacy is map
        && request.resource.data.provenance.legacy.keys().hasAll(['kind', 'id'])
        && (
          request.resource.data.provenance.legacy.kind == 'plan'
          || request.resource.data.provenance.legacy.kind == 'month-event'
        )
        && request.resource.data.provenance.legacy.id is string
        && isNullableString(request.resource.data.provenance.sourceType)
        && isNullableString(request.resource.data.provenance.sourceId);
    }

    function hasCanonicalScheduleEventIdentity(eventId) {
      return (
          request.resource.data.provenance.legacy.kind == 'plan'
          && eventId == 'plan:' + request.resource.data.provenance.legacy.id
        )
        || (
          request.resource.data.provenance.legacy.kind == 'month-event'
          && eventId == 'month-event:' + request.resource.data.provenance.legacy.id
        );
    }

    function hasValidScheduleEventDetails() {
      return (
          request.resource.data.provenance.legacy.kind == 'plan'
          && request.resource.data.plan is map
          && request.resource.data.plan.keys().hasAll([
            'legacyPlanId',
            'seriesId',
            'subject',
            'planType'
          ])
          && request.resource.data.plan.legacyPlanId
            == request.resource.data.provenance.legacy.id
          && request.resource.data.plan.seriesId is string
          && request.resource.data.plan.subject is string
          && request.resource.data.plan.planType is string
          && request.resource.data.general == null
        )
        || (
          request.resource.data.provenance.legacy.kind == 'month-event'
          && request.resource.data.kind == 'general'
          && request.resource.data.plan == null
          && request.resource.data.general is map
          && request.resource.data.general.keys().hasAll([
            'url',
            'checklist',
            'locationTags'
          ])
          && request.resource.data.general.url is string
          && request.resource.data.general.checklist is list
          && request.resource.data.general.locationTags is list
        );
    }

    function isValidScheduleEventDocument(eventId) {
      return request.resource.data.keys().hasAll([
          'schemaVersion',
          'id',
          'userId',
          'title',
          'date',
          'endDate',
          'startTime',
          'endTime',
          'recurrence',
          'category',
          'busy',
          'memo',
          'provenance',
          'createdAt',
          'updatedAt',
          'kind',
          'plan',
          'general'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.id == eventId
        && request.resource.data.userId is string
        && request.resource.data.title is string
        && request.resource.data.date is string
        && request.resource.data.endDate is string
        && request.resource.data.startTime is string
        && request.resource.data.endTime is string
        && request.resource.data.category in [
          'study',
          'class',
          'exam',
          'school',
          'cram-school',
          'deadline',
          'other'
        ]
        && request.resource.data.busy is bool
        && request.resource.data.memo is string
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && (
          request.resource.data.kind == 'study'
          || request.resource.data.kind == 'general'
        )
        && hasValidScheduleEventRecurrence()
        && hasValidScheduleEventProvenance()
        && hasCanonicalScheduleEventIdentity(eventId)
        && hasValidScheduleEventDetails();
    }

    match /admins/{adminId} {
      allow get: if isOwner(adminId) || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /profiles/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && !request.resource.data.keys().hasAny(['weeklyPlanningTracePolicy'])
        && request.resource.data.registeredAt is timestamp
        && request.resource.data.registeredAt == request.time;
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'id',
          'email',
          'username',
          'avatar',
          'createdAt'
        ]);
      allow delete: if false;
    }

    match /plans/{planId} {
      allow read: if canReadOwnedResource();
      allow create: if canCreateLegacyScheduleResource();
      allow update: if canUpdateLegacyScheduleResource();
      allow delete: if canDeleteLegacyScheduleResource();
    }

    match /schedule_events/{eventId} {
      allow read: if canReadOwnedResource();
      allow create: if canCreateOwnedResource()
        && hasScheduleEventMigration(request.resource.data.userId)
        && isValidScheduleEventDocument(eventId);
      allow update: if canUpdateOwnedResource()
        && hasScheduleEventMigration(resource.data.userId)
        && isValidScheduleEventDocument(eventId)
        && request.resource.data.schemaVersion == resource.data.schemaVersion
        && request.resource.data.id == resource.data.id;
      allow delete: if isOwner(resource.data.userId)
        && hasScheduleEventMigration(resource.data.userId);
    }

    match /schedule_event_migrations/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.userId == userId
        && request.resource.data.schemaVersion == 1
        && request.resource.data.migrationVersion == 1
        && request.resource.data.status == 'migrating'
        && request.resource.data.operationId == 'schedule-event-migration-v1:' + userId
        && request.resource.data.revision == 1
        && request.resource.data.startedAt is string
        && request.resource.data.completedAt == null;
      allow update: if isOwner(userId)
        && resource.data.userId == userId
        && request.resource.data.userId == userId
        && resource.data.schemaVersion == 1
        && request.resource.data.schemaVersion == resource.data.schemaVersion
        && resource.data.migrationVersion == 1
        && request.resource.data.migrationVersion == resource.data.migrationVersion
        && resource.data.operationId == 'schedule-event-migration-v1:' + userId
        && request.resource.data.operationId == resource.data.operationId
        && request.resource.data.revision == resource.data.revision
        && request.resource.data.startedAt == resource.data.startedAt
        && request.resource.data.status == 'completed'
        && request.resource.data.completedAt is string
        && request.resource.data.sourcePlanCount is int
        && request.resource.data.sourceMonthEventCount is int
        && request.resource.data.eventCount is int
        && (
          (
            resource.data.status == 'migrating'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status',
              'sourcePlanCount',
              'sourceMonthEventCount',
              'eventCount',
              'completedAt'
            ])
          )
          || (
            resource.data.status == 'completed'
            && request.resource.data.sourcePlanCount == resource.data.sourcePlanCount
            && request.resource.data.sourceMonthEventCount == resource.data.sourceMonthEventCount
            && request.resource.data.eventCount == resource.data.eventCount
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'completedAt'
            ])
          )
        );
      allow delete: if false;
    }

    match /actuals/{actualId} {
      allow read: if canReadOwnedResource();
      allow create: if canCreateOwnedResource();
      allow update: if canUpdateOwnedResource();
      allow delete: if isOwner(resource.data.userId);
    }

    match /day_notes/{dayNoteId} {
      allow read: if canReadOwnedResource();
      allow create: if canCreateOwnedResource();
      allow update: if canUpdateOwnedResource();
      allow delete: if isOwner(resource.data.userId);
    }

    match /month_events/{monthEventId} {
      allow read: if canReadOwnedResource();
      allow create: if canCreateLegacyScheduleResource();
      allow update: if canUpdateLegacyScheduleResource();
      allow delete: if canDeleteLegacyScheduleResource();
    }

    match /todos/{todoId} {
      allow read: if canReadOwnedResource();
      allow create: if canCreateOwnedResource();
      allow update: if canUpdateOwnedResource();
      allow delete: if isOwner(resource.data.userId);
    }

    match /study_subjects/{subjectId} {
      allow read: if canReadOwnedResource();
      allow create: if canCreateOwnedResource();
      allow update: if canUpdateOwnedResource();
      allow delete: if isOwner(resource.data.userId);
    }

    match /study_materials/{materialId} {
      allow read: if canReadOwnedResource();
      allow create: if canCreateOwnedResource();
      allow update: if canUpdateOwnedResource();
      allow delete: if isOwner(resource.data.userId);
    }

    match /schedule_templates/{scheduleTemplateId} {
      allow read: if canReadOwnedResource();
      allow create: if canCreateOwnedResource();
      allow update: if canUpdateOwnedResource();
      allow delete: if isOwner(resource.data.userId);
    }

    match /timetable_terms/{termId} {
      allow read: if canReadOwnedResource();
      allow create: if canCreateOwnedResource();
      allow update: if canUpdateOwnedResource();
      allow delete: if isOwner(resource.data.userId);
    }

    match /timetable_periods/{periodId} {
      allow read: if canReadOwnedResource();
      allow create: if canCreateOwnedResource();
      allow update: if canUpdateOwnedResource();
      allow delete: if isOwner(resource.data.userId);
    }

    match /weekly_planning_personalization_profiles/{userId} {
      allow read, create, update, delete: if isOwner(userId)
        && hasAcceptedWeeklyPlanningPolicy();
    }

    match /user_planning_contexts/{userId} {
      allow read: if isOwner(userId) && hasAcceptedWeeklyPlanningPolicy();
      allow create, update: if isOwner(userId)
        && hasAcceptedWeeklyPlanningPolicy()
        && request.resource.data.schemaVersion == 'studyplanner-user-planning-context-cloud-v1'
        && request.resource.data.ownerId == userId
        && request.resource.data.snapshot.ownerId == userId
        && request.resource.data.revision is int
        && request.resource.data.revision >= 1;
      allow delete: if false;
    }

    match /weekly_planning_approval_operations/{operationId} {
      allow read: if canReadOwnedResource();
      allow create: if canCreateOwnedResource()
        && request.resource.data.schemaVersion == 1
        && request.resource.data.savedItemCount >= 1
        && (
          request.resource.data.status == 'active'
          || (
            request.resource.data.status == 'completed'
            && request.resource.data.expectedItemCount == request.resource.data.savedItemCount
            && request.resource.data.completedAt is string
          )
        );
      allow update: if canUpdateOwnedResource()
        && request.resource.data.schemaVersion == resource.data.schemaVersion
        && request.resource.data.approvalOperationId == resource.data.approvalOperationId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.savedItemCount >= resource.data.savedItemCount
        && (resource.data.status != 'completed' || request.resource.data.status == 'completed')
        && (
          request.resource.data.status != 'completed'
          || (
            request.resource.data.expectedItemCount == request.resource.data.savedItemCount
            && request.resource.data.completedAt is string
          )
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'savedItemCount',
          'expectedItemCount',
          'updatedAt',
          'completedAt',
          'expiresAt'
        ]);
      allow delete: if false;

      match /weekly_planning_approval_items/{itemId} {
        allow read: if canReadOwnedResource();
        allow create: if canCreateOwnedResource()
          && request.resource.data.schemaVersion == 1
          && request.resource.data.status == 'saved'
          && request.resource.data.approvalOperationId is string
          && request.resource.data.sourceDraftBlockId is string
          && request.resource.data.savedPlanId is string
          && request.resource.data.expiresAt is timestamp;
        allow update: if canUpdateOwnedResource()
          && request.resource.data.schemaVersion == resource.data.schemaVersion
          && request.resource.data.approvalOperationId == resource.data.approvalOperationId
          && request.resource.data.sourceDraftBlockId == resource.data.sourceDraftBlockId
          && request.resource.data.savedPlanId == resource.data.savedPlanId
          && request.resource.data.status == resource.data.status
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.expiresAt >= resource.data.expiresAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'updatedAt',
            'expiresAt'
          ]);
        allow delete: if false;
      }
    }

    match /weekly_planning_trace_sessions/{sessionId} {
      allow read, write: if false;
    }

    match /weekly_planning_trace_entries/{entryId} {
      allow read, write: if false;
    }

    match /weekly_planning_trace_access_audit/{auditId} {
      allow read, write: if false;
    }

    match /app_catalogs/{catalogId} {
      allow read: if true;
      allow create, update: if false;
      allow delete: if false;
    }
  }
}
