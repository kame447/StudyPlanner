rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function canReadOwnedResource() {
      return isOwner(resource.data.userId) || isAdmin();
    }

    function canCreateOwnedResource() {
      return isOwner(request.resource.data.userId);
    }

    function canUpdateOwnedResource() {
      return isOwner(resource.data.userId)
        && isOwner(request.resource.data.userId);
    }

    match /admins/{adminId} {
      allow get: if isOwner(adminId) || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /profiles/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    match /plans/{planId} {
      allow read: if canReadOwnedResource();
      allow create: if canCreateOwnedResource();
      allow update: if canUpdateOwnedResource();
      allow delete: if isOwner(resource.data.userId);
    }

    match /actuals/{actualId} {
      allow read: if canReadOwnedResource();
      allow create: if canCreateOwnedResource();
      allow update: if canUpdateOwnedResource();
      allow delete: if isOwner(resource.data.userId);
    }

    match /day_notes/{dayNoteId} {
      allow read: if canReadOwnedResource();
      allow create: if canCreateOwnedResource();
      allow update: if canUpdateOwnedResource();
      allow delete: if isOwner(resource.data.userId);
    }

    match /month_events/{monthEventId} {
      allow read: if canReadOwnedResource();
      allow create: if canCreateOwnedResource();
      allow update: if canUpdateOwnedResource();
      allow delete: if isOwner(resource.data.userId);
    }

    match /todos/{todoId} {
      allow read: if canReadOwnedResource();
      allow create: if canCreateOwnedResource();
      allow update: if canUpdateOwnedResource();
      allow delete: if isOwner(resource.data.userId);
    }

    match /study_subjects/{subjectId} {
      allow read: if canReadOwnedResource();
      allow create: if canCreateOwnedResource();
      allow update: if canUpdateOwnedResource();
      allow delete: if isOwner(resource.data.userId);
    }

    match /study_materials/{materialId} {
      allow read: if canReadOwnedResource();
      allow create: if canCreateOwnedResource();
      allow update: if canUpdateOwnedResource();
      allow delete: if isOwner(resource.data.userId);
    }

    match /schedule_templates/{scheduleTemplateId} {
      allow read: if canReadOwnedResource();
      allow create: if canCreateOwnedResource();
      allow update: if canUpdateOwnedResource();
      allow delete: if isOwner(resource.data.userId);
    }

    match /timetable_terms/{termId} {
      allow read: if canReadOwnedResource();
      allow create: if canCreateOwnedResource();
      allow update: if canUpdateOwnedResource();
      allow delete: if isOwner(resource.data.userId);
    }

    match /timetable_periods/{periodId} {
      allow read: if canReadOwnedResource();
      allow create: if canCreateOwnedResource();
      allow update: if canUpdateOwnedResource();
      allow delete: if isOwner(resource.data.userId);
    }

    match /weekly_planning_trace_sessions/{sessionId} {
      allow read: if isAdmin();
      allow create: if canCreateOwnedResource()
        && request.resource.data.id == sessionId;
      allow update: if (
          canUpdateOwnedResource()
          && request.resource.data.id == resource.data.id
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.logicalConversationId == resource.data.logicalConversationId
          && request.resource.data.startedAt == resource.data.startedAt
          && request.resource.data.schemaVersion == resource.data.schemaVersion
          && request.resource.data.get('archivedAt', null) == resource.data.get('archivedAt', null)
        ) || (
          isAdmin()
          && !('archivedAt' in resource.data)
          && request.resource.data.archivedAt is string
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['archivedAt'])
        );
      allow delete: if false;
    }

    match /weekly_planning_trace_entries/{entryId} {
      allow read: if isAdmin();
      allow create: if canCreateOwnedResource()
        && request.resource.data.id == entryId;
      allow update: if canUpdateOwnedResource()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([]);
      allow delete: if false;
    }

    match /app_catalogs/{catalogId} {
      allow read: if true;
      allow create, update: if false;
      allow delete: if false;
    }
  }
}
