rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasAcceptedWeeklyPlanningPolicy() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid))
          .data.weeklyPlanningTracePolicy.version == '2026-07-18-v1';
    }

    function canReadOwnedResource() {
      return isOwner(resource.data.userId) || isAdmin();
    }

    function canCreateOwnedResource() {
      return isOwner(request.resource.data.userId);
    }

    function canUpdateOwnedResource() {
      return isOwner(resource.data.userId)
        && isOwner(request.resource.data.userId);
    }

    function hasScheduleEventMigration(userId) {
      return exists(
        /databases/$(database)/documents/schedule_event_migrations/$(userId)
      );
    }

    function canCreateLegacyScheduleResource() {
      return canCreateOwnedResource()
        && !hasScheduleEventMigration(request.resource.data.userId);
    }

    function canUpdateLegacyScheduleResource() {
      return canUpdateOwnedResource()
        && !hasScheduleEventMigration(resource.data.userId);
    }

    function canDeleteLegacyScheduleResource() {
      return isOwner(resource.data.userId)
        && !hasScheduleEventMigration(resource.data.userId);
    }

    function isNullableString(value) {
      return value == null || value is string;
    }

    function hasValidScheduleEventRecurrence() {
      return request.resource.data.recurrence is map
        && request.resource.data.recurrence.keys().hasAll([
          'repeat',
          'repeatUntil',
          'excludedDates',
          'rules'
        ])
        && request.resource.data.recurrence.repeat is string
        && isNullableString(request.resource.data.recurrence.repeatUntil)
        && request.resource.data.recurrence.excludedDates is list
        && request.resource.data.recurrence.rules is list;
    }

    function hasValidScheduleEventProvenance() {
      return request.resource.data.provenance is map
        && request.resource.data.provenance.keys().hasAll([
          'legacy',
          'sourceType',
          'sourceId'
        ])
        && request.resource.data.provenance.legacy is map
        && request.resource.data.provenance.legacy.keys().hasAll(['kind', 'id'])
        && (
          request.resource.data.provenance.legacy.kind == 'plan'
          || request.resource.data.provenance.legacy.kind == 'month-event'
        )
        && request.resource.data.provenance.legacy.id is string
        && isNullableString(request.resource.data.provenance.sourceType)
        && isNullableString(request.resource.data.provenance.sourceId);
    }

    function hasCanonicalScheduleEventIdentity(eventId) {
      return (
          request.resource.data.provenance.legacy.kind == 'plan'
          && eventId == 'plan:' + request.resource.data.provenance.legacy.id
        )
        || (
          request.resource.data.provenance.legacy.kind == 'month-event'
          && eventId == 'month-event:' + request.resource.data.provenance.legacy.id
        );
    }

    function hasValidScheduleEventDetails() {
      return (
          request.resource.data.provenance.legacy.kind == 'plan'
          && request.resource.data.plan is map
          && request.resource.data.plan.keys().hasAll([
            'legacyPlanId',
            'seriesId',
            'subject',
            'planType'
          ])
          && request.resource.data.plan.legacyPlanId
            == request.resource.data.provenance.legacy.id
          && request.resource.data.plan.seriesId is string
          && request.resource.data.plan.subject is string
          && request.resource.data.plan.planType is string
          && request.resource.data.general == null
        )
        || (
          request.resource.data.provenance.legacy.kind == 'month-event'
          && request.resource.data.kind == 'general'
          && request.resource.data.plan == null
          && request.resource.data.general is map
          && request.resource.data.general.keys().hasAll([
            'url',
            'checklist',
            'locationTags'
          ])
          && request.resource.data.general.url is string
          && request.resource.data.general.checklist is list
          && request.resource.data.general.locationTags is list
        );
    }

    function isValidScheduleEventDocument(eventId) {
      return request.resource.data.keys().hasAll([
          'schemaVersion',
          'id',
          'userId',
          'title',
          'date',
          'endDate',
          'startTime',
          'endTime',
          'recurrence',
          'category',
          'busy',
          'memo',
          'provenance',
          'createdAt',
          'updatedAt',
          'kind',
          'plan',
          'general'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.id == eventId
        && request.resource.data.userId is string
        && request.resource.data.title is string
        && request.resource.data.date is string
        && request.resource.data.endDate is string
        && request.resource.data.startTime is string
        && request.resource.data.endTime is string
        && request.resource.data.category in [
          'study',
          'class',
          'exam',
          'school',
          'cram-school',
          'deadline',
          'other'
        ]
        && request.resource.data.busy is bool
        && request.resource.data.memo is string
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && (
          request.resource.data.kind == 'study'
          || request.resource.data.kind == 'general'
        )
        && hasValidScheduleEventRecurrence()
        && hasValidScheduleEventProvenance()
        && hasCanonicalScheduleEventIdentity(eventId)
        && hasValidScheduleEventDetails();
    }

    function validAnnouncementContent(data) {
      return data.schemaVersion == 1
        && data.category in ['お知らせ', 'アップデート', '不具合', 'メンテナンス', 'その他']
        && data.title is string && data.title.size() > 0 && data.title.size() <= 120
        && data.title.matches('.*[^\\s].*')
        && data.body is string && data.body.size() > 0 && data.body.size() <= 10000
        && data.body.matches('[\\s\\S]*[^\\s][\\s\\S]*')
        && data.revision is int && data.revision > 0;
    }
    function validAnnouncementDraft(data) {
      return data.keys().hasOnly(['schemaVersion', 'category', 'title', 'body', 'revision', 'publishedRevision', 'createdAt', 'updatedAt'])
        && validAnnouncementContent(data)
        && data.publishedRevision is int && data.publishedRevision >= 0 && data.publishedRevision <= data.revision
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    function publicationMatchesDraft(id, data) {
      let draft = getAfter(/databases/$(database)/documents/announcement_drafts/$(id)).data;
      return draft.revision == data.revision && draft.publishedRevision == data.revision
        && draft.title == data.title && draft.body == data.body && draft.category == data.category;
    }
    match /announcement_drafts/{id} {
      allow get: if isAdmin();
      allow list: if isAdmin() && request.query.limit != null && request.query.limit <= 26;
      allow create: if isAdmin() && validAnnouncementDraft(request.resource.data)
        && request.resource.data.revision == 1 && request.resource.data.publishedRevision == 0
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if isAdmin() && validAnnouncementDraft(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && ((request.resource.data.revision == resource.data.revision + 1
            && request.resource.data.publishedRevision == resource.data.publishedRevision
            && request.resource.data.updatedAt == request.time)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['publishedRevision'])
            && request.resource.data.publishedRevision == resource.data.revision
            && getAfter(/databases/$(database)/documents/announcements/$(id)).data.revision == resource.data.revision
            && getAfter(/databases/$(database)/documents/announcements/$(id)).data.publishedAt == request.time));
      allow delete: if false;
    }
    match /announcements/{id} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && request.query.limit != null && request.query.limit <= 26;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['schemaVersion', 'category', 'title', 'body', 'revision', 'publishedAt'])
        && validAnnouncementContent(request.resource.data)
        && request.resource.data.publishedAt == request.time
        && publicationMatchesDraft(id, request.resource.data)
        && (resource == null || request.resource.data.revision > resource.data.revision);
      allow delete: if false;
    }
    match /announcement_reads/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId) && request.resource.data.keys().hasOnly(['through'])
        && request.resource.data.through is timestamp && request.resource.data.through <= request.time
        && (resource == null || request.resource.data.through >= resource.data.through);
      allow delete, list: if false;
      match /items/{id} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId) && request.query.limit != null && request.query.limit <= 25;
        allow create, update: if isOwner(userId) && request.resource.data.keys().hasOnly(['publishedAt'])
          && request.resource.data.publishedAt is timestamp
          && request.resource.data.publishedAt <= get(/databases/$(database)/documents/announcements/$(id)).data.publishedAt
          && (resource == null || request.resource.data.publishedAt >= resource.data.publishedAt);
        allow delete: if false;
      }
    }

    match /admins/{adminId} {
      allow get: if isOwner(adminId) || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /profiles/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && !request.resource.data.keys().hasAny(['weeklyPlanningTracePolicy'])
        && request.resource.data.registeredAt is timestamp
        && request.resource.data.registeredAt == request.time;
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'id',
          'email',
          'username',
          'avatar',
          'createdAt'
        ]);
      allow delete: if false;
    }

    match /plans/{planId} {
      allow read: if canReadOwnedResource();
      allow create: if canCreateLegacyScheduleResource();
      allow update: if canUpdateLegacyScheduleResource();
      allow delete: if canDeleteLegacyScheduleResource();
    }

    match /schedule_events/{eventId} {
      allow read: if canReadOwnedResource();
      allow create: if canCreateOwnedResource()
        && hasScheduleEventMigration(request.resource.data.userId)
        && isValidScheduleEventDocument(eventId);
      allow update: if canUpdateOwnedResource()
        && hasScheduleEventMigration(resource.data.userId)
        && isValidScheduleEventDocument(eventId)
        && request.resource.data.schemaVersion == resource.data.schemaVersion
        && request.resource.data.id == resource.data.id;
      allow delete: if isOwner(resource.data.userId)
        && hasScheduleEventMigration(resource.data.userId);
    }

    match /schedule_event_migrations/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.userId == userId
        && request.resource.data.schemaVersion == 1
        && request.resource.data.migrationVersion == 1
        && request.resource.data.status == 'migrating'
        && request.resource.data.operationId == 'schedule-event-migration-v1:' + userId
        && request.resource.data.revision == 1
        && request.resource.data.startedAt is string
        && request.resource.data.completedAt == null;
      allow update: if isOwner(userId)
        && resource.data.userId == userId
        && request.resource.data.userId == userId
        && resource.data.schemaVersion == 1
        && request.resource.data.schemaVersion == resource.data.schemaVersion
        && resource.data.migrationVersion == 1
        && request.resource.data.migrationVersion == resource.data.migrationVersion
        && resource.data.operationId == 'schedule-event-migration-v1:' + userId
        && request.resource.data.operationId == resource.data.operationId
        && request.resource.data.revision == resource.data.revision
        && request.resource.data.startedAt == resource.data.startedAt
        && request.resource.data.status == 'completed'
        && request.resource.data.completedAt is string
        && request.resource.data.sourcePlanCount is int
        && request.resource.data.sourceMonthEventCount is int
        && request.resource.data.eventCount is int
        && (
          (
            resource.data.status == 'migrating'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status',
              'sourcePlanCount',
              'sourceMonthEventCount',
              'eventCount',
              'completedAt'
            ])
          )
          || (
            resource.data.status == 'completed'
            && request.resource.data.sourcePlanCount == resource.data.sourcePlanCount
            && request.resource.data.sourceMonthEventCount == resource.data.sourceMonthEventCount
            && request.resource.data.eventCount == resource.data.eventCount
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'completedAt'
            ])
          )
        );
      allow delete: if false;
    }

    // Attendance is private evidence, independent of study-time Actual records.
    match /class_attendance/{userId}/classes/{templateId}/records/{date} {
      function validAttendanceDate() {
        let parts = date.split('-');
        let year = int(parts[0]);
        let month = int(parts[1]);
        let day = int(parts[2]);
        let leapYear = year % 4 == 0 && (year % 100 != 0 || year % 400 == 0);
        return date.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
          && year >= 100
          && (month != 2 || day <= (leapYear ? 29 : 28))
          && (!(month in [4, 6, 9, 11]) || day <= 30);
      }
      function validAttendance() {
        return request.resource.data.keys().hasOnly([
            'schemaVersion', 'userId', 'templateId', 'date', 'status', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.schemaVersion == 1
          && request.resource.data.userId == userId
          && request.resource.data.templateId == templateId
          && request.resource.data.date == date
          && validAttendanceDate()
          && request.resource.data.status in ['present', 'absent', 'late-or-left']
          && request.resource.data.createdAt is string
          && request.resource.data.updatedAt is string
          && get(/databases/$(database)/documents/schedule_templates/$(templateId)).data.userId == userId;
      }
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && validAttendance();
      allow update: if isOwner(userId) && validAttendance()
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    match /actuals/{actualId} {
      allow read: if canReadOwnedResource();
      allow create: if canCreateOwnedResource();
      allow update: if canUpdateOwnedResource();
      allow delete: if isOwner(resource.data.userId);
    }

    match /day_notes/{dayNoteId} {
      allow read: if canReadOwnedResource();
      allow create: if canCreateOwnedResource();
      allow update: if canUpdateOwnedResource();
      allow delete: if isOwner(resource.data.userId);
    }

    match /month_events/{monthEventId} {
      allow read: if canReadOwnedResource();
      allow create: if canCreateLegacyScheduleResource();
      allow update: if canUpdateLegacyScheduleResource();
      allow delete: if canDeleteLegacyScheduleResource();
    }

    match /todos/{todoId} {
      allow read: if canReadOwnedResource();
      allow create: if canCreateOwnedResource();
      allow update: if canUpdateOwnedResource();
      allow delete: if isOwner(resource.data.userId);
    }

    match /study_subjects/{subjectId} {
      allow read: if canReadOwnedResource();
      allow create: if canCreateOwnedResource();
      allow update: if canUpdateOwnedResource();
      allow delete: if isOwner(resource.data.userId);
    }

    match /study_materials/{materialId} {
      allow read: if canReadOwnedResource();
      allow create: if canCreateOwnedResource();
      allow update: if canUpdateOwnedResource();
      allow delete: if isOwner(resource.data.userId);
    }

    match /schedule_templates/{scheduleTemplateId} {
      allow read: if canReadOwnedResource();
      allow create: if canCreateOwnedResource();
      allow update: if canUpdateOwnedResource();
      allow delete: if isOwner(resource.data.userId);
    }

    match /timetable_terms/{termId} {
      allow read: if canReadOwnedResource();
      allow create: if canCreateOwnedResource();
      allow update: if canUpdateOwnedResource();
      allow delete: if isOwner(resource.data.userId);
    }

    match /timetable_periods/{periodId} {
      allow read: if canReadOwnedResource();
      allow create: if canCreateOwnedResource();
      allow update: if canUpdateOwnedResource();
      allow delete: if isOwner(resource.data.userId);
    }

    function validInquiryPhoto(photo) {
      return photo is map
        && photo.keys().hasOnly(['sha256', 'contentType', 'byteLength', 'width', 'height'])
        && photo.sha256 is string && photo.sha256.matches('^[a-f0-9]{64}$')
        && photo.contentType in ['image/jpeg', 'image/png']
        && photo.byteLength is int && photo.byteLength > 0 && photo.byteLength <= 5242880
        && photo.width is int && photo.width > 0 && photo.width <= 8192
        && photo.height is int && photo.height > 0 && photo.height <= 8192
        && photo.width * photo.height <= 24000000;
    }

    function validInquirySchema(data) {
      return (data.schemaVersion == 1
          && data.keys().hasOnly(['schemaVersion', 'userId', 'body', 'createdAt']))
        || (data.schemaVersion == 2
          && data.keys().hasOnly(['schemaVersion', 'userId', 'body', 'createdAt', 'attachments'])
          && data.attachments is list
          && data.attachments.size() >= 1 && data.attachments.size() <= 3
          && validInquiryPhoto(data.attachments[0])
          && (data.attachments.size() < 2 || validInquiryPhoto(data.attachments[1]))
          && (data.attachments.size() < 3 || validInquiryPhoto(data.attachments[2])));
    }

    // Inquiry content is separate from telemetry and is never editable by clients.
    match /support_inquiries/{inquiryId} {
      // A missing receipt must be readable to perform a create-only transaction.
      allow get: if isSignedIn() && (
        resource == null || isOwner(resource.data.userId) || isAdmin()
      );
      allow list: if isAdmin()
        && request.query.limit != null && request.query.limit <= 26;
      allow create: if isSignedIn()
        && inquiryId.matches('^[a-zA-Z0-9_-]{20,80}$')
        && validInquirySchema(request.resource.data)
        && isOwner(request.resource.data.userId)
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 1
        && request.resource.data.body.size() <= 2000
        && request.resource.data.body.matches('[\\s\\S]*[^\\s][\\s\\S]*')
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/support_inquiry_limits/$(request.auth.uid))
          .data.inquiryId == inquiryId
        && getAfter(/databases/$(database)/documents/support_inquiry_limits/$(request.auth.uid))
          .data.submittedAt == request.time;
      allow update, delete: if false;
    }

    match /support_inquiry_limits/{userId} {
      allow get: if isOwner(userId);
      allow list, delete: if false;
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['inquiryId', 'submittedAt'])
        && request.resource.data.inquiryId is string
        && request.resource.data.inquiryId.matches('^[a-zA-Z0-9_-]{20,80}$')
        && request.resource.data.submittedAt == request.time
        && (resource == null || request.time >= resource.data.submittedAt + duration.value(60, 's'))
        && !exists(/databases/$(database)/documents/support_inquiries/$(request.resource.data.inquiryId))
        && getAfter(/databases/$(database)/documents/support_inquiries/$(request.resource.data.inquiryId))
          .data.userId == userId
        && getAfter(/databases/$(database)/documents/support_inquiries/$(request.resource.data.inquiryId))
          .data.createdAt == request.time;
    }

    match /weekly_planning_personalization_profiles/{userId} {
      allow read, create, update, delete: if isOwner(userId)
        && hasAcceptedWeeklyPlanningPolicy();
    }

    match /user_planning_contexts/{userId} {
      allow read: if isOwner(userId) && hasAcceptedWeeklyPlanningPolicy();
      allow create, update: if isOwner(userId)
        && hasAcceptedWeeklyPlanningPolicy()
        && request.resource.data.schemaVersion == 'studyplanner-user-planning-context-cloud-v1'
        && request.resource.data.ownerId == userId
        && request.resource.data.snapshot.ownerId == userId
        && request.resource.data.revision is int
        && request.resource.data.revision >= 1;
      allow delete: if false;
    }

    match /weekly_planning_approval_operations/{operationId} {
      allow read: if canReadOwnedResource();
      allow create: if canCreateOwnedResource()
        && request.resource.data.schemaVersion == 1
        && request.resource.data.savedItemCount >= 1
        && (
          request.resource.data.status == 'active'
          || (
            request.resource.data.status == 'completed'
            && request.resource.data.expectedItemCount == request.resource.data.savedItemCount
            && request.resource.data.completedAt is string
          )
        );
      allow update: if canUpdateOwnedResource()
        && request.resource.data.schemaVersion == resource.data.schemaVersion
        && request.resource.data.approvalOperationId == resource.data.approvalOperationId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.savedItemCount >= resource.data.savedItemCount
        && (resource.data.status != 'completed' || request.resource.data.status == 'completed')
        && (
          request.resource.data.status != 'completed'
          || (
            request.resource.data.expectedItemCount == request.resource.data.savedItemCount
            && request.resource.data.completedAt is string
          )
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'savedItemCount',
          'expectedItemCount',
          'updatedAt',
          'completedAt',
          'expiresAt'
        ]);
      allow delete: if false;

      match /weekly_planning_approval_items/{itemId} {
        allow read: if canReadOwnedResource();
        allow create: if canCreateOwnedResource()
          && request.resource.data.schemaVersion == 1
          && request.resource.data.status == 'saved'
          && request.resource.data.approvalOperationId is string
          && request.resource.data.sourceDraftBlockId is string
          && request.resource.data.savedPlanId is string
          && request.resource.data.expiresAt is timestamp;
        allow update: if canUpdateOwnedResource()
          && request.resource.data.schemaVersion == resource.data.schemaVersion
          && request.resource.data.approvalOperationId == resource.data.approvalOperationId
          && request.resource.data.sourceDraftBlockId == resource.data.sourceDraftBlockId
          && request.resource.data.savedPlanId == resource.data.savedPlanId
          && request.resource.data.status == resource.data.status
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.expiresAt >= resource.data.expiresAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'updatedAt',
            'expiresAt'
          ]);
        allow delete: if false;
      }
    }

    match /weekly_planning_trace_sessions/{sessionId} {
      allow read, write: if false;
    }

    match /weekly_planning_trace_entries/{entryId} {
      allow read, write: if false;
    }

    match /weekly_planning_trace_access_audit/{auditId} {
      allow read, write: if false;
    }

    match /app_catalogs/{catalogId} {
      allow read: if true;
      allow create, update: if false;
      allow delete: if false;
    }
  }
}
