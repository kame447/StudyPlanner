+
+function normalizeLooseTitleText(text: string): string {
+  return text
+    .replace(/[０-９]/g, (char) =>
+      String.fromCharCode(char.charCodeAt(0) - 0xfee0)
+    )
+    .replace(/[：]/g, ":")
+    .replace(/[／]/g, "/")
+    .replace(/[「」]/g, " ")
+    .replace(/\s+/g, " ")
+    .trim();
+}
+
+function trimLooseTitleCandidate(text: string): string {
+  let current = normalizeLooseTitleText(text);
+  let previous = "";
+
+  while (current && current !== previous) {
+    previous = current;
+    current = current
+      .replace(
+        /^(?:(?:今日|明日|明後日|今週|来週)(?:の|は)?|(?:朝|昼|夜)(?:は)?|(?:そのあと|その後|次に|続けて)(?:は)?)+/,
+        ""
+      )
+      .replace(
+        /^(?:(?:寝る前|寝るまえ|起きてすぐ|起床後|朝食後|昼食後|夕食後|食後|授業後|学校後|帰宅後|風呂後|お風呂後)(?:に|で|は)?)+/,
+        ""
+      )
+      .replace(/^(?:軽く|少し|ちょっと|まず|だけ|のみ)+/, "")
+      .replace(/^(?:の|は|を|に|で|と)+/, "")
+      .replace(
+        /(?:を(?:やる|する|進める|入れる|入れて|勉強する)|やる|する|進める|入れる|入れて|勉強する)$/,
+        ""
+      )
+      .replace(/(?:の|は|を|に|で|と)+$/, "")
+      .replace(/\s+/g, " ")
+      .trim();
+  }
+
+  return current;
+}
+
+function isGenericTitleCandidate(text: string): boolean {
+  const normalized = normalizeLooseTitleText(text);
+  if (!normalized) {
+    return true;
+  }
+
+  return GENERIC_TITLE_CANDIDATES.has(normalized);
+}
+
+function maybeStripLeadingSubject(text: string): string {
+  const subject = inferCatalogSubject(text);
+  if (!subject) {
+    return text;
+  }
+
+  const stripped = text.replace(
+    new RegExp(
+      `^${subject.replace(/[.*+?^${}()|[\\]\\]/g, "\\$&")}(?:の|を|は|:|：|/|／|\\s+)`,
+      "i"
+    ),
+    ""
+  ).trim();
+
+  if (!stripped || isGenericTitleCandidate(stripped)) {
+    return text;
+  }
+
+  return stripped;
+}
+
+function buildLexicalTitleCandidate(text: string): string | undefined {
+  const cleaned = maybeStripLeadingSubject(trimLooseTitleCandidate(text));
+  if (!cleaned || isGenericTitleCandidate(cleaned)) {
+    return undefined;
+  }
+
+  return cleaned;
+}
+
+export function inferEventTitle(
+  contentText?: string,
+  contextText?: string
+): string | undefined {
+  const sources = [contentText, contextText].filter(
+    (value): value is string => typeof value === "string" && value.trim().length > 0
+  );
+
+  for (const source of sources) {
+    const lexicalCandidate = buildLexicalTitleCandidate(source);
+    if (!lexicalCandidate) {
+      continue;
+    }
+
+    const catalogCandidate = inferCatalogTitle(lexicalCandidate);
+    if (catalogCandidate && !isGenericTitleCandidate(catalogCandidate)) {
+      return catalogCandidate;
+    }
+
+    return lexicalCandidate;
+  }
+
+  return undefined;
+}
